<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boardkit.boardd</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BOARDKIT@/boardd/boardd</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/boardd.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/boardd.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
